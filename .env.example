# Deal Desk — server environment (copy to .env.local; never commit real values).
# Every screen reads live sources; anything not configured shows an honest "not connected"/"unavailable" state.

# Crustdata (company/person/job/web data). Required for deal and person pages.
CRUSTDATA_API_KEY=
# Dev only: file cache for Crustdata + voice responses (avoids re-spending credits). Leave unset in production.
DEALDESK_CACHE_DIR=
DEALDESK_CACHE_TTL_SECONDS=

# Organizational memory (Postgres). Without it the Memory panel says "memory store not configured (DATABASE_URL)".
DATABASE_URL=

# Google (Gmail read + Calendar read) via a stored OAuth refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Outbound (email/invites/posts). dry_run (default) builds requests but sends nothing; live really sends.
OUTBOUND_MODE=dry_run

# Voice greeting (ElevenLabs TTS, server-side only).
ELEVENLABS_API_KEY=
# Default: nPczCjzI2devNBz1zQrb ("Brian — Deep, Resonant and Comforting"); model default eleven_flash_v2_5.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Name the Today greeting uses (no sign-in in this build). Optional.
DEALDESK_GREETING_NAME=

# Optional AI model: phrases the greeting/answers from the same facts. Without it, text is composed deterministically.
ANTHROPIC_API_KEY=
DEALDESK_LLM_MODEL=

# Other connectors (status only in this build).
AGENTMAIL_API_KEY=
SLACK_BOT_TOKEN=
FIREFLIES_API_KEY=
