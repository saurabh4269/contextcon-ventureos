# Deal Desk — server environment (copy to .env.local; never commit real values).
# Demo UI (port/src/fixtures) is the default so the live site keeps its current look. Real Crustdata overlays the
# same screens when the URL names a source (?domain=, ?linkedin=, ?q=). Set live to drop fixtures on wired routes.

# demo (default when unset) · live (Crustdata wrappers on wired routes; no fixture fallback)
DEALDESK_DATA_MODE=demo

# Crustdata (company/person/job/web data). Used by /deal?domain=, /person?linkedin=, /ask?q= and /agent?q=.
CRUSTDATA_API_KEY=
# Optional second key; used automatically (and labelled in the trace) when the primary is out of credits (402/429 quota)
CRUSTDATA_API_KEY_BACKUP=
# Dev only: file cache for Crustdata + voice responses (avoids re-spending credits). Leave unset in production.
DEALDESK_CACHE_DIR=
DEALDESK_CACHE_TTL_SECONDS=

# Organizational memory (Postgres). Without it the Memory panel says "memory store not configured (DATABASE_URL)".
DATABASE_URL=

# Google (Gmail read + Calendar read) via a stored OAuth refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Must be registered on the OAuth client. Run the demo with `npm run dev:demo` (port 3000) to match.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
# Pre-selects the account on Google's sign-in screen (Settings › Connectors › Gmail › Connect)
GOOGLE_LOGIN_HINT=
# Where the in-app sign-in stores its refresh token (default .dealdesk/google-token.json, gitignored; "off" disables)
DEALDESK_GOOGLE_TOKEN_FILE=
APP_URL=http://localhost:3000

# Outbound (email/invites/posts). dry_run (default) builds requests but sends nothing; live really sends.
OUTBOUND_MODE=dry_run
# OUTBOUND_LIVE=1 is the same as OUTBOUND_MODE=live. Live sends go only to this allowlist (comma-separated) and each
# needs an Approve click in the UI. No default: empty blocks every send. Put real addresses only in .env.local.
OUTBOUND_LIVE=
DEMO_RECIPIENT_ALLOWLIST=you@example.com,teammate@example.com

# Voice greeting (ElevenLabs TTS, server-side only).
ELEVENLABS_API_KEY=
# Default: nPczCjzI2devNBz1zQrb ("Brian — Deep, Resonant and Comforting"); model default eleven_flash_v2_5.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Name the Today greeting uses (no sign-in in this build). Optional.
DEALDESK_GREETING_NAME=

# AI model for the research agent (/ask, POST /api/live/screen). Without a key it reports model_unavailable and offers
# the deterministic Sourcing agent. OpenAI Responses API; Anthropic is used instead when ANTHROPIC_API_KEY is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high
ANTHROPIC_API_KEY=
DEALDESK_LLM_MODEL=

# Other connectors (status only in this build).
AGENTMAIL_API_KEY=
SLACK_BOT_TOKEN=
FIREFLIES_API_KEY=

# Optional: builder decision-engine deployment (GET /api/deals/:id/decisions fills cited decisions from it)
DEALDESK_BUILDER_URL=
